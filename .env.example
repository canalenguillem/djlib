# =============================================================================
# DJ Library - variables de entorno
# Copia este fichero a .env y rellena los valores marcados como OBLIGATORIO.
# Nunca subas .env al repositorio.
# =============================================================================

# --- Base de datos (MariaDB) -------------------------------------------------
MARIADB_ROOT_PASSWORD=cambia-esta-clave-root
MARIADB_DATABASE=djlibrary
MARIADB_USER=djlibrary
MARIADB_PASSWORD=cambia-esta-clave-db

# Host/puerto que usa el backend para conectarse (dentro de compose es "db").
# MariaDB no publica puerto en el host: solo se accede desde la red de compose.
DB_HOST=db
DB_PORT=3306

# --- JWT ---------------------------------------------------------------------
# OBLIGATORIO. Generalo con:  openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Backend -----------------------------------------------------------------
# Prefijo con el que el frontend expone la API por su proxy. Hace que /docs y
# /openapi.json generen URLs correctas al entrar por http://localhost:PUERTO/api/docs
API_ROOT_PATH=/api

# CORS: vacio a proposito. El navegador habla siempre con el origen del
# frontend, que hace de proxy, asi que no hay peticiones entre origenes.
# Rellenalo (separado por comas) solo si algun dia sirves la API en otro dominio.
CORS_ORIGINS=

MIN_PASSWORD_LENGTH=10

# Rate limiting del login: intentos fallidos permitidos por IP y ventana (seg.)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# El backend siempre ve la IP del proxy del frontend, asi que conviene leer la
# IP real de X-Forwarded-For para que el rate limiting distinga clientes.
TRUST_PROXY_HEADERS=true

# --- Biblioteca musical ------------------------------------------------------
# Carpeta de los mp3 DENTRO del contenedor (montada en el volumen music_data)
MUSIC_DIR=/data/music
# Corta descargas eternas (directos, albumes enteros). 3600 = 1 hora
MAX_TRACK_DURATION_SECONDS=3600
DOWNLOAD_TIMEOUT_SECONDS=900
# 0 = mejor calidad VBR
YTDLP_AUDIO_QUALITY=0
# Si YouTube empieza a pedir verificacion, exporta las cookies del navegador
# a un fichero y pon aqui su ruta dentro del contenedor
YTDLP_COOKIES_FILE=

# --- Reconocimiento de audio (fase posterior, desactivado) --------------------
RECOGNITION_PROVIDER=
RECOGNITION_API_KEY=

# --- Seed del usuario admin inicial ------------------------------------------
SEED_ADMIN_USERNAME=enguillem
SEED_ADMIN_EMAIL=
# OBLIGATORIO. Minimo MIN_PASSWORD_LENGTH caracteres.
SEED_ADMIN_PASSWORD=

# --- Frontend ----------------------------------------------------------------
# Unico puerto publicado en el host. Cambialo si lo tienes ocupado.
FRONTEND_HOST_PORT=5175

# Nombres de host desde los que abriras el frontend, separados por comas
# (ademas de localhost y de cualquier IP, que Vite permite siempre). Sin esto,
# entrar por nombre da 403 "Blocked request". Usa "*" para permitir cualquiera
# en una LAN de confianza.
VITE_ALLOWED_HOSTS=

# Ruta base de la API vista desde el navegador. Relativa = via proxy del
# frontend. Solo tocalo si publicas el backend en su propio dominio.
VITE_API_BASE_URL=/api
