# =============================================================================
# DJ Library - variables de entorno
# Copia este fichero a .env y rellena los valores marcados como OBLIGATORIO.
# Nunca subas .env al repositorio.
# =============================================================================

# --- Base de datos (MariaDB) -------------------------------------------------
MARIADB_ROOT_PASSWORD=cambia-esta-clave-root
MARIADB_DATABASE=djlibrary
MARIADB_USER=djlibrary
MARIADB_PASSWORD=cambia-esta-clave-db

# Host/puerto que usa el backend para conectarse (dentro de compose es "db").
# MariaDB no publica puerto en el host: solo se accede desde la red de compose.
DB_HOST=db
DB_PORT=3306

# --- JWT ---------------------------------------------------------------------
# OBLIGATORIO. Generalo con:  openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Backend -----------------------------------------------------------------
# Prefijo con el que el frontend expone la API por su proxy. Hace que /docs y
# /openapi.json generen URLs correctas al entrar por http://localhost:PUERTO/api/docs
API_ROOT_PATH=/api

# CORS: vacio a proposito. El navegador habla siempre con el origen del
# frontend, que hace de proxy, asi que no hay peticiones entre origenes.
# Rellenalo (separado por comas) solo si algun dia sirves la API en otro dominio.
CORS_ORIGINS=

MIN_PASSWORD_LENGTH=10

# Rate limiting del login: intentos fallidos permitidos por IP y ventana (seg.)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# El backend siempre ve la IP del proxy del frontend, asi que conviene leer la
# IP real de X-Forwarded-For para que el rate limiting distinga clientes.
TRUST_PROXY_HEADERS=true

# --- Biblioteca musical ------------------------------------------------------
# Carpeta de los mp3 DENTRO del contenedor (montada en el volumen music_data)
MUSIC_DIR=/data/music
# Tope duro para una URL concreta: corta directos y albumes enteros
MAX_TRACK_DURATION_SECONDS=3600
# Tope al elegir entre los resultados de una busqueda: descarta los mixes que
# YouTube devuelve como primer resultado cuando la consulta no es exacta
MAX_SONG_DURATION_SECONDS=900
# Cuantos resultados se miran antes de elegir
SEARCH_CANDIDATES=5
# Buscando solo por artista se explora su catalogo: conviene ver mas
SEARCH_ARTIST_CANDIDATES=10
DOWNLOAD_TIMEOUT_SECONDS=900
# Que flujo se descarga. Se guarda TAL CUAL, sin recodificar: YouTube sirve
# como mucho unos 130 kbps con perdida, y pasarlo a mp3 320 solo anade una
# segunda perdida y triplica el tamano. Se prefiere m4a (AAC) porque rekordbox,
# Serato y Mixxx lo leen de forma nativa; opus les da problemas.
YTDLP_FORMAT=bestaudio[ext=m4a]/bestaudio/best
# Si YouTube empieza a pedir verificacion, exporta las cookies del navegador
# a un fichero y pon aqui su ruta dentro del contenedor
YTDLP_COOKIES_FILE=

# --- Lectura de capturas de pantalla (OpenAI) ---------------------------------
# Permite subir una captura (por ejemplo la lista de Shazam) y que se extraigan
# las canciones. Sin clave, la seccion no aparece en la pantalla de Reconocer.
# La clave se saca en https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Tiene que ser un modelo con vision. Se deja configurable porque el catalogo
# cambia y no todas las cuentas tienen acceso a los mismos.
OPENAI_MODEL=gpt-4o-mini

# --- Spotify -------------------------------------------------------------------
# Se crea la app en https://developer.spotify.com/dashboard
# En la app hay que registrar esta Redirect URI, exactamente igual:
#   https://djlib.enguillem.es/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://djlib.enguillem.es/api/spotify/callback

# --- Reconocimiento de audio --------------------------------------------------
# "audd" para activarlo, vacio para desactivarlo (la pantalla se oculta sola).
# La clave se saca en https://dashboard.audd.io/signup — 300 peticiones gratis
# al registrarse, sin tarjeta; despues 5 $ por cada 1000.
RECOGNITION_PROVIDER=
RECOGNITION_API_KEY=
RECOGNITION_TIMEOUT_SECONDS=45

# --- Seed del usuario admin inicial ------------------------------------------
SEED_ADMIN_USERNAME=enguillem
SEED_ADMIN_EMAIL=
# OBLIGATORIO. Minimo MIN_PASSWORD_LENGTH caracteres.
SEED_ADMIN_PASSWORD=

# --- Copias de seguridad ------------------------------------------------------
# Donde se guardan. Apuntalo a un NAS o disco externo si lo tienes.
BACKUP_DIR=
# Cuantas copias se conservan antes de borrar las mas antiguas
BACKUP_KEEP=7

# --- Frontend ----------------------------------------------------------------
# Unico puerto publicado en el host. Cambialo si lo tienes ocupado.
FRONTEND_HOST_PORT=5175

# Nombres de host desde los que abriras el frontend, separados por comas
# (ademas de localhost y de cualquier IP, que Vite permite siempre). Sin esto,
# entrar por nombre da 403 "Blocked request". Usa "*" para permitir cualquiera
# en una LAN de confianza.
VITE_ALLOWED_HOSTS=

# Ruta base de la API vista desde el navegador. Relativa = via proxy del
# frontend. Solo tocalo si publicas el backend en su propio dominio.
VITE_API_BASE_URL=/api
